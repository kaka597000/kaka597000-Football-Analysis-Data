745db03fb1f90d167bc161dc8e47d37b9186ecd6e4893047f19bdef","recorded_at":"2026-11-17T21:26:14.624675+08:00","revision":1,"role":"comprehensive","settled":true,"total_direction":"under","total_eligible":true,"total_line":2.0,"total_settlement":"push","track":"comprehensive","version":"WCPP-COMPREHENSIVE-REPAIR-1","wdl":"主胜","wdl_hit":false},{"actual":"3-0","competition":"uefa.nations","evaluation_role":"FIRST_PREMATCH","freeze_id":"14e642ee78683bea-v000001","league_level":"B","match_id":"espn:401861192","name":"爱尔兰—科索沃","primary":"1-0","primary_hit":false,"quote":{"bookmaker":"nova88","line":2.0,"market":"asian_total","match_id":"espn:401861192","over_odds":1.82,"provider":"InferSports","provider_event_id":"evt_G537DAY6","query_time":"2026-11-17T13:02:57.286574+00:00","quoted_at":"2026-11-17T12:50:17Z","source_sha256":"1f69f44f5a958a284d85cf37b7d0e8f967e581b3bdea935a5e7404b48e364875","source_url":"https://api.infersports.dev/v1/events/evt_G537DAY6/odds?markets=1x2%2Casian_handicap%2Ctotals&period=full_time&format=decimal","under_odds":2.09,"verified":true},"rank":3,"record_sha256":"f8fd9760039e9827c599ee3ced3985ac502bbd62d96363635777814bca022e1f","recorded_at":"2026-11-17T21:26:14.704861+08:00","revision":1,"role":"comprehensive","settled":true,"total_direction":"under","total_eligible":true,"total_line":2.0,"total_settlement":"loss","track":"comprehensive","version":"WCPP-COMPREHENSIVE-REPAIR-1","wdl":"主胜","wdl_hit":true}],"summary":{"coverage":{"primary":1.0,"total":1.0,"wdl":1.0},"pending":0,"population":3,"primary_accuracy":0.0,"primary_hits":0,"primary_n":3,"primary_wilson95":[5.551115123125783e-17,0.5614970317550454],"settled":3,"total_n":3,"total_non_push_n":2,"total_settlements":{"half_loss":0,"half_win":0,"loss":1,"push":1,"win":1},"total_strict_full_win_rate":0.5,"wdl_accuracy":0.3333333333333333,"wdl_hits":1,"wdl_n":3}}]},"report":"# 11月17日全部预测复盘｜北京时间2026年11月18日\n\nHELLO BOSS\n\n**11场全部完成核验：第一比分2/11（18.2%），胜平负5/11（45.5%）；大小球4全赢、1半赢、1走盘、5全输。严格全赢率4/10＝40.0%，走盘剔出该分母，半赢没有当作全赢。**\n\n范围为11月17日分析的中国、日本、新加坡三场友谊赛，以及11月18日03:45八场欧国联。11场全部有明确首版三项选择，覆盖率均100%；未剔除红牌、点球、乌龙或失败场次。日本临场版本单独评价，不替换首版。\n\n|比赛|原第一比分|90分钟赛果|比分|原胜平负|方向|原实际大小球|结算|\n|---|---|---|---|---|---|---|---|\n|新加坡—巴西|0-5|0-7|×|客胜|✓|小5.25|全输|\n|中国—巴林|1-0|2-2|×|主胜|×|小2.25|全输|\n|日本—巴拉圭|2-1|1-2|×|主胜|×|大2.5|全赢|\n|威尔士—葡萄牙|1-2|2-3|×|客胜|✓|小3.25|全输|\n|乌克兰—格鲁吉亚|0-0|1-0|×|平局|×|小2.25|全赢|\n|匈牙利—北爱尔兰|1-0|1-1|×|主胜|×|小2|走盘|\n|爱尔兰—科索沃|1-0|3-0|×|主胜|✓|小2|全输|\n|以色列—奥地利|0-1|1-1|×|客胜|×|小3|全赢|\n|丹麦—挪威|2-1|2-3|×|主胜|×|小3.25|全输|\n|波兰—瑞典|1-1|1-1|✓|平局|✓|小3.25|全赢|\n|波黑—罗马尼亚|2-1|2-1|✓|主胜|✓|大2.75|半赢|\n\n## 首版、临场修订与TOP3\n\n日本首版11:44：2-1／主胜／大2.5，实际1-2，比分错、方向错、大球全赢。21:04临场修订：1-1／主胜／小2.75，比分和方向仍错，小球半输。**这次修订没有改善比分，并把正确的大小球方向改错。** 两次真实冻结、盘口和评价分别保留。\n\n欧国联原TOP3：乌克兰0-0、匈牙利1-0、爱尔兰1-0，比分0/3，胜平负1/3，大小球1全赢、1走盘、1全输。友谊赛原研究TOP3就是中国、日本、新加坡三场，比分0/3、胜平负1/3，大小球1全赢、2全输。没有赛后更换名单或排序。\n\n## 本轮错误主要在哪里\n\n综合点比分合计23球，实际37球；7次单队零球选择仅3次正确。这是选分偏差诊断，不把点比分合计称为模型期望进球。原11场中9场选小：3全赢、1走盘、5全输；偏小判断本轮没有兑现。\n\n人工改分相对原Current、固定刷新Test、锁定xG参考均净少中1场：增加波黑2-1命中，却分别丢掉两个原基准正确比分。相对原Test净增0，相对独立候选净增1；这些基准不能拼成一个赛后最优模型。两场第三国xG场景从1-0/1-1变成0-0/0-1均未中，场地判断与预测效果必须分开验证。\n\n红牌、点球和乌龙按实际发生时间解释。爱尔兰26分钟红牌和两点球确实改变比赛路径；威尔士—葡萄牙的5球全在74分钟红牌之前；丹麦在最后点球之前已2-2；巴西在乌龙之前已6-0。后三场大小球失败不能归因于最后的特殊事件。\n\n所有11场本次ESPN过程均没有真实xG；射门与射正只能确认可见创造量，不能据此断言“全是运气”或补造机会质量。统计点球字段有三场冲突（中国、爱尔兰、挪威），复盘采用逐球事件、分段比分及球队身份核验，原始字段原样保存。\n\n## 逐场过程与判断\n\n### 新加坡—巴西\n\n新加坡0-7巴西。巴西22射11正，新加坡10射1正，巴西31分钟已4-0、65分钟已6-0，74分钟新加坡球员Raoul Suhaimi乌龙使巴西获益到7-0。零封与客胜判断成立，巴西进球数低估两球、小5.25失败；即使不计最后乌龙也已超过5.25，不能把失误归咎于乌龙。旧/刷新友谊赛模型分别1-1/1-2，对强弱差压缩过大；市场让球/总球映射已明显更接近，但人工选择5球上限路径仍不成立。\n\n### 中国—巴林\n\n中国2-2巴林。2分钟、20分钟已0-2落后，首球为传中头球、第二球来自角球后续；37分钟追回一球，80分钟点球扳平。中国15射只有2正，巴林6射3正，控场/射门量不能证明防守零封。原1-0与小2.25都低估了巴林得分和早失球后的开放路径。没有红牌；两队已在20分钟达到2球，不能把4球完全归于末段点球。\n\n### 日本—巴拉圭\n\n日本1-2巴拉圭。日本17射5正、66.3%控球，巴拉圭5射4正；巴拉圭两球均来自角球后续，日本85分钟才追回一球。此前连续友谊赛获胜没有延续，10人首发变化的定性修订也没有正确识别定位球防守风险。首版2-1错、主胜错，但大2.5全赢；临场1-1仍错、主胜仍错，小2.75半输。没有真实球员影响权重或xG，不能把这次变化称为数值模型自动优化。\n\n### 威尔士—葡萄牙\n\n威尔士2-3葡萄牙。半场已2-2，70分钟形成最终2-3，葡萄牙74分钟内托第二黄退场。威尔士22射8正，葡萄牙11射6正；客胜命中，原1-2把双方各少估一球，小3.25全输。全部5球均发生在红牌前，红牌不能解释这次小球失败。全场射门含红牌后的比赛状态，不全部视为赛前实力差。\n\n### 乌克兰—格鲁吉亚\n\n乌克兰1-0格鲁吉亚。乌克兰第1分钟进球后保持比分；双方射门11-12、射正3-4。格鲁吉亚90分钟才第二黄退场，无法解释开场失球。原0-0与平局失败，小2.25全赢；第三国场地情景把固定刷新/xG的1-0改成0-0，本次改分减少一次命中。场地事实正确，但自动去掉全部主场效应并未获得这一场的效果支持。\n\n### 匈牙利—北爱尔兰\n\n匈牙利1-1北爱尔兰。匈牙利35分钟领先，北爱65分钟扳平；射门17-8，但射正仅2-2。原1-0过度押注北爱零球；北爱此前五场零封描述的是其防守，不能推出其本场不进球。比分、主胜均未中，小2.0走盘。原Current的1-1命中，综合改成1-0丢掉该次命中。\n\n### 爱尔兰—科索沃\n\n爱尔兰3-0科索沃。科索沃26分钟红牌，爱尔兰28、50分钟两次罚进点球，75分钟再进头球；28射12正对5射3正含长时间人数优势。主胜与客队零球成立，1-0及小2.0失败。早红牌和两点球显著改变比赛路径，但保留全量复盘，不剔除此场，也不把赛后多打一人的射门数量直接当成赛前攻击强度。\n\n### 以色列—奥地利\n\n以色列1-1奥地利。以色列3射2正先得分，奥地利21射6正扳平；原0-1和客胜均未中，小3.0全赢。客队创造量占优却不足以兑现零封客胜；第三国情景把原/xG参考的1-1改成0-1，本次又少一次命中。缺真实xG，不能仅凭射门数断言所有偏差都是终结运气。\n\n### 丹麦—挪威\n\n丹麦2-3挪威。丹麦14分钟已2-0，挪威37分钟追回一球，83分钟扳平（NFF官方记84分钟），补时点球制胜；射门7-22、射正4-7。原2-1、主胜、小3.25全部失败，挪威持续创造和丹麦领先后的风险被低估。最终点球发生前已2-2，小3.25已经落入全输，不能只归咎于绝杀。ESPN2-3与InferSports2-2冲突已由挪威足协官方2-3报道解决。\n\n### 波兰—瑞典\n\n波兰1-1瑞典。波兰16分钟领先，瑞典24分钟扳平；射门10-17、射正3-6。原1-1、平局、小3.25全部命中。瑞典虽已锁定第一，仍有明显机会产出，锁定排名本身不能代替实际比赛强度判断。\n\n### 波黑—罗马尼亚\n\n波黑2-1罗马尼亚。罗马尼亚6分钟领先，波黑44分钟扳平、82分钟反超；双方均13射6正。原2-1与主胜命中，大2.75半赢。本次人工改分相对1-0/1-1研究参考增加一次命中，但不能用这一场抵消其他改错场次。\n\n## 模型对照\n\n下面是本批8场欧国联的同场描述，A/B具体版本在JSON中分别统计；均为保留研究候选，不冒称活动模型。原Current/Test没有事前冻结大小球方向的记录不回填方向；16日原五轨计划与17日新报价参考分别结算。\n\n|保留研究轨|比分命中|胜平负命中|\n|---|---:|---:|\n|原Current|3/8|3/8|\n|原Test|2/8|4/8|\n|固定刷新Current|3/8|3/8|\n|固定刷新Test|3/8|4/8|\n|独立候选|1/8|4/8|\n|锁定xG方案：A shotmap-75／B expected-75|3/8|4/8|\n|综合第一推荐|2/8|4/8|\n\nxG首次前向验证已完成8/8：13个原锁定方案和纯进球基线均为比分3/8、胜平负4/8，按上午原盘口均为4全赢、1走盘、3全输。**这一批没有观察到加入xG后的命中增益。** 不能用晚间新盘的结算替代上午原盘，也没有从13个方案里赛后重选赢家。\n\n概率质量按级别分别看（越低越好）：A组2场纯进球/shotmap-75的比分log-loss为3.6042/3.5890，B组6场纯进球/expected-75为2.3183/2.3316；A略改善、B略退步。样本有限，不能称已证明最优权重。缺失xG的球队仍使用原先声明的进球回退。\n\n友谊赛三场：保留历史版、固定配方刷新版、让球/总球映射、1X2/总球映射的统计第一比分均0/3；原冻结只有概率而未选胜平负/大小球方向的参考，不在赛后补方向算命中。活动Current/Test三场仍为不可用，统计为覆盖0/3，不与研究轨混算。\n\n## 完整前向队列及累计记录\n\n11月16日预先锁定的18场五轨比较现已18/18结算，待结算0；这18场包含前一批10场，不属于本次11场的额外分母。完整表见repair-complete-forward-review.json；队列已用现有运行入口更新，未重新推理或发起API请求。\n\n|级别／独立样本|原Current|原Test|固定Current|固定Test|独立候选|\n|---|---:|---:|---:|---:|---:|\n|A／4场|0/4|0/4|0/4|0/4|0/4|\n|B／8场|3/8|2/8|3/8|3/8|1/8|\n|C／4场|0/4|0/4|0/4|0/4|1/4|\n|D／2场|1/2|0/2|0/2|0/2|0/2|\n\n另已复核52场欧国联原Current/Test首次冻结，逐级/版本统计见cumulative-first-candidates-52.json；未混入后续修订，不用不同级别的最佳结果拼接提升。\n\n## 处理决定与可核验证据\n\n本次完成了真实赛果核验、全部原版本结算、13种xG方案未来比较、18场原计划闭环以及52场原模型累计复核。保留活动参数和研究工件；本次没有新训练或晋级。后续研究重点为人工零球/一球改分、第三国主场效应、强弱悬殊场次的尾部分布，以及阵容变化对进攻和防守的分别影响。新的规则以新的未来冻结样本检验；本次已观察比赛不重复冒称未见测试。\n\nESPN11场均有明确FT和两个半场比分，37个进球事件与球员所属队/进球受益队逐一核对。InferSports10场吻合；丹麦备用源2-2与ESPN2-3冲突，由挪威足协官方2-3赛后报道解决，备源错误值仍保存，原因未作无依据推断。NFF/ESPN的扳平分钟84/83及补时分钟展示差异分源保留。\n\n官方丹麦赛果：[挪威足协赛后报道](https://www.fotball.no/landslag/norge-a-herrer/2026/disse-starter-mot-danmark2/)。逐场原始API URL、HTTP状态、真实采集时间及哈希见verified-results.json与采集目录。77条原始赛前记录和所有旧工件哈希保持。复盘、模型对照和处理决定追加冻结；不发布环境。\n","report_sha256":"95b2f2fb65840b43e7140221fca29f87ae00a864c3c1a9d84eac3f4d06de2cef","source_conflicts":{"all_results_corroborated":11,"goal_minute_disagreements":[{"actor":"Martin Ødegaard","espn":"83","handling":"Keep source-specific minutes.","nff":"84"},{"actor":"Erling Braut Haaland penalty","espn":"90+6","handling":"Official page supports stoppage-time goal; does not independently confirm +6.","nff":"90 with narrative stoppage time"}],"official_source":{"away_score":3,"half_time":{"away":1,"home":2},"home_score":2,"http_status":200,"kickoff_local":"17.11.2026 20:45","match_number":"99101000922","observed_at":"2026-11-18T00:24:23.562987+00:00","plain_text_extract":"/workspace/WCPP/reports/all-review-20261118-0818/friendly-results/norway-official-denmark-report-extract.txt","provider":"Norges Fotballforbund","published_date":"2026-11-17","source_path":"/workspace/WCPP/reports/all-review-20261118-0818/friendly-results/raw/norway-official-denmark-report.html","source_sha256":"ed1de2ed11078659a51a7c92ab209a1fcdd994a3a87e9519e8384bff586b83de","source_url":"https://www.fotball.no/landslag/norge-a-herrer/2026/disse-starter-mot-danmark2/","title":"Avgjorde på 