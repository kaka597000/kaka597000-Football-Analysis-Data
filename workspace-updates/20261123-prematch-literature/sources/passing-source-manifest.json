  "method": {
    "event_order": "source array order within each match; only immediately adjacent event records are paired",
    "edge_rule": "source event is Pass with tag 1801 accurate; next event must be same matchPeriod and teamId, and both playerIds present and different. It is an inferred recipient proxy, never a stated recipient. No cross-team possession or half/terminal boundary is bridged.",
    "pass_volume": "all eventName=Pass records by the team, successful or unsuccessful",
    "eligible_edge_count": "number of accepted event pairs (sum of edge weights)",
    "active_nodes": "unique sender or inferred receiver player IDs among accepted edges",
    "density": "number of distinct directed non-self edges / (active_nodes * (active_nodes-1))",
    "weighted_outgoing_entropy_normalized": "unweighted mean across nodes with outgoing edges of Shannon entropy of outgoing edge weight shares divided by ln(active_nodes); null if no outgoing edge",
    "largest_sender_share": "maximum player outgoing edge weight / total accepted edge weight",
    "largest_receiver_share": "maximum player incoming edge weight / total accepted edge weight",
    "reciprocity": "sum over directed edges min(weight(a,b),weight(b,a)) / total edge weight; weighted share of edge volume with a reciprocal counterpart, range [0,1]",
    "forward_edge_share": "fraction of accepted pass pairs with pass destination x > origin x, only pairs with both x coordinates present",
    "final_third_edge_share": "fraction of accepted pass pairs with pass destination x >= 66.67, only pairs with both x coordinates present",
    "coordinate_caveat": "Coordinates are source-native 0-100; forward means numeric x increases, without asserting team attacking orientation. Exact pass origin/destination and next-event start positions retained per edge."
  },
